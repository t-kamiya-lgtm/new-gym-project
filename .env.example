# Supabase (new project, dedicated to this system -- not shared with pm-chat-bot)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sumaregi EC (primedirect.jp) API -- OAuth2 app registered under
# 基本設定 > 外部アプリ連携. See src/lib/smaregi/oauth.ts.
SMAREGI_OAUTH_BASE_URL=https://www.primedirect.jp
SMAREGI_CLIENT_ID=
SMAREGI_CLIENT_SECRET=
SMAREGI_REDIRECT_URI=https://<your-deployment-domain>/api/smaregi/oauth/callback
